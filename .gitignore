dist-newstyle/
wasm/vendor/
wasm/out/
node_modules/
*.wasm
*.hi
*.o

# staged into web/ by scripts/serve.sh
wasm/web/probe.jsffi.mjs
wasm/web/*.journal

# The engine the app ships, copied in by apps/web/scripts/sync-hledger.mjs. The
# rest of the wasm in here is measurement and is ignored above; this pair is the
# only one that is published, and rebuilding it needs the ghc-wasm toolchain, so
# it travels with the source that produced it rather than being derived on
# whichever machine happens to deploy.
!apps/web/public/hledger.wasm
apps/web/dist/
apps/web/dev-dist/

# written by apps/web/scripts/collect-licenses.mjs at build time
apps/web/src/core/generated/

# No settings file with a name like this is ever committed, anywhere in here.
# The ones that are — docs/.env.example — say so in their own name.
.env
.env.*
!.env.example
