---
/**
 * The front page: what the app is, to somebody who has not opened it.
 *
 * Short on purpose. Four cards, each the top of a page rather than the whole of
 * a subject, and then the way to those pages. Anything that takes more than a
 * paragraph to say is somewhere else, which is what keeps the button near the
 * top of the screen where somebody deciding can reach it.
 */
import Shell from "./Shell.astro"
import type { Words } from "./words"

const { words } = Astro.props as { words: Words }
const HLEDGER = "https://hledger.org"
/**
 * Where the app is. Development points at the one on this machine, a build at
 * the published one, and PUBLIC_APP overrides either — so a fresh clone needs
 * no settings file to link to the right place.
 */
const APP =
  import.meta.env.PUBLIC_APP ??
  (import.meta.env.DEV ? "http://localhost:8396" : "https://choai.dev")

const ja = words.lang === "ja"
const at = (path: string): string => (path.startsWith("/") && ja ? `/ja${path}` : path)

/**
 * The app, described to whatever catalogues software.
 *
 * It names the app's own address rather than this one, because the thing being
 * described is the app and this site only explains it — said here, the two
 * names are one piece of software with somewhere to read about it, rather than
 * two sites that happen to share a word. Every claim is one the repository
 * already makes: free, GPL, and running in a browser.
 */
const SCHEMA = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "choai",
  url: APP,
  description: words.description,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web browser",
  inLanguage: ["en", "ja"],
  isAccessibleForFree: true,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: ["https://github.com/mrksye/choai"],
}
---

<Shell words={words} schema={SCHEMA}>
  <h1>{words.tagline}</h1>
  <p class="lead">{words.lead}</p>

  <div class="ways">
    <a class="button" href={APP}>{words.open}</a>
    <a class="quiet" href={HLEDGER} rel="noreferrer">{words.aboutHledger} →</a>
  </div>

  <ul class="points">
    {
      words.points.map((point) => (
        <li>
          <h2>{point.heading}</h2>
          <p>{point.body}</p>
          {/* The link finishes the card's sentence rather than saying "read
              more" four times over. */}
          <a href={at(point.at)} rel={point.at.startsWith("/") ? null : "noreferrer"}>
            {point.more} →
          </a>
        </li>
      ))
    }
  </ul>

</Shell>
