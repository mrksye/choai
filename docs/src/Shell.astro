---
/**
 * The frame every page here is in: the head, the look, the list of pages, the
 * way to the other language, and the footer.
 *
 * The list of pages is beside the reading on a window with room for it and
 * above it on one without, and it is on every page including the front. This is
 * documentation: what else there is to read belongs on the screen at all times,
 * not at the end of what you happen to be reading.
 *
 * Styles are inline, there are no fonts to fetch, and nothing written here
 * reaches off the page at all. Visits are counted by the host on the way out,
 * which puts its own counter into a name it is already serving — so a counter
 * written in here as well would be the same visit counted twice, and there is
 * nothing in this file to keep in step with it.
 */
import type { Words } from "./words"
import { GUIDES, LEGAL, same } from "./paths"
import "./site.css"

interface Props {
  words: Words
  /** Named for pages that are not the front one; it goes before the app's name. */
  heading?: string
  /**
   * What the page is, said to a cataloguer rather than to a reader. Only the
   * front page carries one: the same statement repeated under every reading
   * describes the app six times over, and none of the readings is the app.
   */
  schema?: object
}

const { words, heading, schema } = Astro.props

/** Where all of this is, app and site together, for anyone who wants to read it
 * or run their own. */
const SOURCE = "https://github.com/mrksye/choai"
const ja = words.lang === "ja"

/**
 * The same page without its language on the front.
 *
 * Matched as a whole segment rather than as the letters at the start: a page
 * called `/japan-and-tax` begins with the same two letters as the Japanese of
 * everything, and stripping them by spelling would send a reader to
 * `/pan-and-tax`. Nothing here is called that today, which is exactly the sort
 * of thing that stays true until it does not.
 */
const here = Astro.url.pathname
const inEnglish = here.replace(/^\/ja(?=\/|$)/, "") || "/"

/** Said as a whole address, which is what anything cataloguing a page expects. */
const absolute = (path: string): string => new URL(path, Astro.site).href

const title = heading === undefined ? words.title : `${heading} — choai`
const at = (path: string): string => (ja ? `/ja${path}` : path)

/**
 * The same page in the other language, rather than its front page. Someone
 * reading the terms who switches wants the terms, not to start again.
 */
const other = ja ? inEnglish : `/ja${inEnglish}`

/** The two runs of pages, as they are listed. */
const runs = [
  { heading: words.readingsHeading, pages: GUIDES },
  { heading: words.legalHeading, pages: LEGAL },
]
---

<!doctype html>
<html lang={words.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={words.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000031" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={words.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="choai" />
    <meta property="og:url" content={absolute(here)} />
    {/* Said as a whole address here too: a card is unfurled by something that
        fetched the page from somewhere else, and has no page of its own to
        resolve a path against. */}
    <meta property="og:image" content={absolute(words.image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={words.tagline} />
    <meta property="og:locale" content={ja ? "ja_JP" : "en_US"} />
    <meta property="og:locale:alternate" content={ja ? "en_US" : "ja_JP"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={words.description} />
    <meta name="twitter:image" content={absolute(words.image)} />
    {/* One address for a page that answers to two: the host serves both
        spellings of a path, which is two addresses for one page as far as
        anything cataloguing it is concerned. */}
    <link rel="canonical" href={absolute(here)} />
    <link rel="alternate" hreflang="en" href={absolute(inEnglish)} />
    <link rel="alternate" hreflang="ja" href={absolute(`/ja${inEnglish}`)} />
    <link rel="alternate" hreflang="x-default" href={absolute(inEnglish)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body>
    {/* Outside main, so that the banner is a banner and the reading is the
        reading — a screen reader is told which is which by where they are. */}
    <header>
      <img src="/favicon.svg" alt="" width="20" height="20" />
      <a class="home" href={at("/")}><strong>choai</strong></a>
      <a class="switch" href={other}>{words.other.label}</a>
    </header>

    <div class="body">
      <nav class="pages" aria-label={words.readingsHeading}>
        <a href={at("/")} aria-current={same(inEnglish, "/") ? "page" : undefined}>
          {words.homeTitle}
        </a>
        {
          runs.map((run) => (
            <>
              <p>{run.heading}</p>
              {run.pages.map((reading) => (
                <a
                  href={at(reading.path)}
                  aria-current={same(inEnglish, reading.path) ? "page" : undefined}
                >
                  {(ja ? reading.ja : reading.en).title}
                </a>
              ))}
            </>
          ))
        }
      </nav>

      <div class="column">
        <main><slot /></main>

        <footer>
          <p><strong>{words.licenceHeading}</strong></p>
          <p>{words.licence}</p>
          <p>{words.builtWith}</p>
          <nav>
            <a href={SOURCE} rel="noreferrer">{words.sourceTitle}</a>
          </nav>
        </footer>
      </div>
    </div>
  </body>
</html>
