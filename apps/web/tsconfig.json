{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.boundary.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.test.json" }
  ],
  /* Not used for building — the references carry their own. Here because the
     test runner reads this file, and nothing else, to resolve `~`. */
  "compilerOptions": {
    /* The seam. `~/edition/chosen` is a name with no file: vite points it at the
       edition being built, and this points it at the one this repository
       defaults to, which is what everything that is not vite resolves. Written
       above the wildcard because an exact key is tried first. */
    "paths": {
      "~/edition/chosen": ["./src/editions/global/index.ts"],
      "~/*": ["./src/*"]
    }
  }
}
