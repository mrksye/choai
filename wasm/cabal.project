-- Build configuration for the wasm32-wasi feasibility probe.
--
-- Everything needed to make hledger-lib build for wasm lives here rather than
-- in vendor/. Keeping upstream sources untouched is a hard requirement for this
-- project: the whole point is to be able to drop in a newer hledger release
-- without carrying a fork. Anything that cannot be expressed at this level gets
-- recorded in RESULTS.md as a cost against that goal.

packages:
  hledger-wasm
  hledger-reports
  vendor/hledger/hledger-lib

-- Replacements for Hackage packages that cannot compile for wasm32-wasi.
-- A local package shadows the Hackage one of the same name, so these swap in
-- without hledger's cabal file or sources being edited. See each shim's
-- description for what it stands in for and why the substitute is honest
-- rather than merely a stub.
packages:
  shims/terminal-size

-- The wasm cross compiler ships these as boot libraries. Without pinning them
-- to "installed", cabal tries to build its own copies from Hackage for wasm32,
-- which fails for the ones that wrap system APIs.
-- Mirrors ghc-wasm-meta's own cabal.project.local.
constraints:
  Cabal installed,
  Cabal-syntax installed,
  array installed,
  base installed,
  binary installed,
  bytestring installed,
  containers installed,
  deepseq installed,
  directory installed,
  exceptions installed,
  filepath installed,
  ghc-bignum installed,
  ghc-boot installed,
  ghc-boot-th installed,
  ghc-compact installed,
  ghc-experimental installed,
  ghc-heap installed,
  ghc-internal installed,
  ghc-platform installed,
  ghc-prim installed,
  ghci installed,
  hpc installed,
  integer-gmp installed,
  mtl installed,
  os-string installed,
  parsec installed,
  pretty installed,
  process installed,
  rts installed,
  semaphore-compat installed,
  stm installed,
  system-cxx-std-lib installed,
  template-haskell installed,
  text installed,
  time installed,
  transformers installed,
  unix installed

allow-newer:
  all:Cabal,
  all:Cabal-syntax,
  all:array,
  all:base,
  all:binary,
  all:bytestring,
  all:containers,
  all:deepseq,
  all:directory,
  all:exceptions,
  all:filepath,
  all:ghc-bignum,
  all:ghc-boot,
  all:ghc-boot-th,
  all:ghc-compact,
  all:ghc-experimental,
  all:ghc-heap,
  all:ghc-internal,
  all:ghc-platform,
  all:ghc-prim,
  all:ghci,
  all:hpc,
  all:integer-gmp,
  all:mtl,
  all:os-string,
  all:parsec,
  all:pretty,
  all:process,
  all:rts,
  all:semaphore-compat,
  all:stm,
  all:system-cxx-std-lib,
  all:template-haskell,
  all:text,
  all:time,
  all:transformers,
  all:unix

-- Optimisation is left at ghc-wasm-meta's default (-O1), which was measured
-- rather than assumed. Building everything at -O2 grew the stripped module from
-- 16.5 MB to 26.7 MB, 62% larger, and bought 4% (269 ms -> 258 ms parsing a
-- thousand transactions). There is size headroom to spend, but not at that
-- exchange rate. See RESULTS.md.
